# =============================================================================
# Bali-Can Limited — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.production.example .env
#
# This .env file is used by docker compose to inject variables into
# all service containers.
#
# How to generate secrets:
#   JWT_SECRET:    openssl rand -hex 32
#   AUTH_SECRET:   openssl rand -base64 32
# =============================================================================

# === Domain ===
DOMAIN=sslplan.com
# Replace with your actual domain name (no protocol). Used only for reference;
# the URL-specific vars below are what services actually consume.

# === PostgreSQL ===
POSTGRES_PASSWORD=change-this-to-a-strong-password
# Required. Password for the sslplan database user. Set to a long random value.

# === JWT ===
JWT_SECRET=your-jwt-secret-here
# Required. Used by the backend to sign and verify auth tokens.
# Generate: openssl rand -hex 32

JWT_EXPIRES_IN=1h
# Optional. Token expiry duration.

# === Frontend URLs (must exactly match production) ===
FRONTEND_URL=https://sslplan.com
# Required. Used by backend for CORS origin and callback redirects.

AUTH_URL=https://sslplan.com
# Required. Used by Auth.js for session redirects and callbacks.
# Must match exactly what users type in their browser.

NEXT_PUBLIC_API_URL=https://sslplan.com/api
# Required. Used by the frontend browser code to call the backend API.
# Must be publicly accessible.

PUBLIC_UPLOAD_BASE_URL=https://media.sslplan.com/public
# Required. HTTPS CDN/object-storage prefix for public product images.

# === Auth.js ===
AUTH_SECRET=your-auth-secret-here
# Required. Used by Auth.js for session encryption and CSRF tokens.
# Generate: openssl rand -base64 32

# === Paystack ===
PAYSTACK_SECRET_KEY=
# Required for live payments. Get from Paystack dashboard.

PAYSTACK_WEBHOOK_SECRET=
# Optional dedicated webhook HMAC secret. Falls back to PAYSTACK_SECRET_KEY.

PAYMENT_CURRENCY=GHS
# Required. Production startup rejects any value other than GHS.

# === Email (Resend) ===
RESEND_API_KEY=
# Required for transactional emails (quotation PDFs, invoices).
# Get from: https://resend.com/api-keys

RESEND_FROM_EMAIL=no-reply@sslplan.com
# Required. Verified from-address for transactional emails.

# === Monitoring and Metrics ===
ALERT_WEBHOOK_URL=
# Required. HTTPS incident receiver for payment, email, and readiness alerts.

SENTRY_DSN=
# Required. Sentry project DSN for centralized exception aggregation.

SENTRY_TRACES_SAMPLE_RATE=0.05

METRICS_TOKEN=
# Required. Generate at least 32 random characters.

# === Admin Registration ===
ADMIN_SECRET_KEY=
# Required to register admin accounts. Set a strong, unique value.
# Admin registration is DISABLED when this is empty.

# === Elasticsearch (optional) ===
ELASTICSEARCH_URL=
# Optional. Set if running an Elasticsearch instance for product search indexing.
# Leave empty to fall back to SQL LIKE queries.

# === S3-Compatible Object Storage ===
UPLOAD_STORAGE_DRIVER=s3
UPLOAD_MAX_IMAGE_SIZE=5242880
# Optional. Max uploaded image size in bytes (default 5MB).

S3_BUCKET=balican-production
S3_REGION=af-south-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_EXPIRES_SECONDS=60
# Leave credentials empty only when the server has an IAM/workload role.

# === Encrypted Off-Site Database Backups ===
BACKUP_ENCRYPTION_KEY=
BACKUP_RCLONE_REMOTE=s3:balican-production/database-backups
BACKUP_RETENTION_DAYS=14
