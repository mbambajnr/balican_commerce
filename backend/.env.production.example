# =============================================================================
# Bali-Can Limited — Backend Production Environment Variables
# =============================================================================
# This file documents the backend env vars expected in production.
# These values are set via docker compose (../.env), NOT directly here.
# Keep this file as documentation only.
#
# How to generate secrets:
#   JWT_SECRET:  openssl rand -hex 32
# =============================================================================

# === Server ===
# PORT=4000                          # (set in docker-compose.yml)
# NODE_ENV=production                # (set in Dockerfile)

# === Database ===
# DATABASE_URL=postgresql://...      # (set in docker-compose.yml from env vars)

# === JWT ===
# JWT_SECRET=...                     # (set from .env → docker compose)
# JWT_EXPIRES_IN=1h

# === Frontend ===
# FRONTEND_URL=https://sslplan.com   # (set from .env → docker compose)

# === Paystack ===
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# PAYMENT_CURRENCY=GHS

# === Email ===
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# === Monitoring ===
# ALERT_WEBHOOK_URL=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# APP_RELEASE=                       # set automatically by scripts/deploy.sh
# METRICS_TOKEN=

# === Admin ===
# ADMIN_SECRET_KEY=

# === Elasticsearch ===
# ELASTICSEARCH_URL=

# === Uploads ===
# UPLOAD_STORAGE_DRIVER=s3
# UPLOAD_DIR=/app/uploads            # (set in docker-compose.yml)
# PUBLIC_UPLOAD_BASE_URL=https://media.sslplan.com/public
# UPLOAD_MAX_IMAGE_SIZE=5242880
# S3_BUCKET=
# S3_REGION=af-south-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URL_EXPIRES_SECONDS=60
