# =============================================================================
# Bali-Can Limited — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================
#
# How to generate secrets:
#   JWT_SECRET:        openssl rand -hex 32
#   ADMIN_SECRET_KEY:  openssl rand -hex 16
#

# === Server ===
PORT=4000
# Optional. The port the backend server listens on. Defaults to 4000.

NODE_ENV=development
# Required. Set to 'production' for production deployments.
# In production, CORS origins, rate limits, and error verbosity are affected.

# === Database ===
DATABASE_URL=postgresql://sslplan:sslplan_dev@localhost:5432/sslplan
# Required. PostgreSQL connection string.
# Production: postgresql://user:password@host:port/dbname?sslmode=require

# === JWT ===
JWT_SECRET=your-jwt-secret-here
# Required. Used to sign and verify auth tokens.
# Production: Must be unique and at least 32 characters. Startup fails otherwise.

JWT_EXPIRES_IN=1h
# Optional. Backend access-session expiry. Production default is one hour.

# === Paystack ===
PAYSTACK_SECRET_KEY=
# Optional for development. Required for live payment processing.
# Production startup fails when this is empty.
# Get from: https://dashboard.paystack.com/#/settings/developer

# === Paystack Webhook ===
PAYSTACK_WEBHOOK_SECRET=
# Optional dedicated webhook signing secret. Falls back to PAYSTACK_SECRET_KEY.
# In production, NODE_ENV=production ensures the webhook fails closed.
# For development/testing, the webhook silently accepts when unset.
# Set to your Paystack secret key (starts with sk_ or sk_live_) or the
# webhook secret from Paystack Dashboard → Settings → Webhooks → Webhook Secret.
# HMAC SHA-512 verification is performed against the raw request body bytes.

PAYMENT_CURRENCY=GHS
# Required in production. Only GHS is supported; startup rejects other values.

# === Email (Resend) ===
RESEND_API_KEY=
# Optional in development; required in production for procurement documents.
# Production startup fails when this is empty.
# Get from: https://resend.com/api-keys

RESEND_FROM_EMAIL=
# Required in production. Sender address verified with Resend.

# === Operational alerts and telemetry ===
ALERT_WEBHOOK_URL=
# Required in production. HTTPS webhook for critical payment, email, and readiness alerts.
# Compatible with a small alert relay, incident platform, or Slack-compatible webhook adapter.
# Optional in development; required in production.

SENTRY_DSN=
# Required in production. Centralized exception aggregation DSN.

SENTRY_TRACES_SAMPLE_RATE=0.05
# Optional. Fraction of transactions sent for performance tracing.

APP_RELEASE=
# Set to the immutable git SHA or release identifier during deployment.

METRICS_TOKEN=
# Required in production, minimum 32 characters. Protects /internal/metrics.

# === Frontend ===
FRONTEND_URL=http://localhost:3000
# Required. The frontend URL used for CORS origin and redirects.
# Also used as the canonical base URL for PDF product links and Merchant Center feeds.
# Production: Must be an absolute HTTPS URL (e.g. https://sslplan.com).
# Multiple origins: Not supported; set one canonical URL here.

# === Elasticsearch ===
ELASTICSEARCH_URL=http://localhost:9200
# Optional. Elasticsearch connection string for product search indexing.
# Leave empty to disable ES (product search falls back to SQL LIKE queries).
# Production: Set to your production ES endpoint.

# === Admin ===
ADMIN_SECRET_KEY=
# Required for admin account registration. Set a strong, secret value.
# Admin registration is DISABLED when this is empty.
# Register at: /admin/register (frontend) or POST /api/auth/admin-register (API)
# Do NOT commit this value to version control.

# === Upload Storage ===
UPLOAD_STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
UPLOAD_MAX_IMAGE_SIZE=5242880
# Local is for development/test only. Production must use s3.

S3_BUCKET=
S3_REGION=af-south-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_EXPIRES_SECONDS=60
# S3_ENDPOINT is optional for AWS and required for most compatible providers.
# Static credentials are optional when the runtime has an IAM/workload role.
# PUBLIC_UPLOAD_BASE_URL should be the HTTPS CDN or public-bucket base URL.

# === Encrypted Database Backups ===
BACKUP_ENCRYPTION_KEY=
# Required when scripts/backup-db.sh runs with NODE_ENV=production.
# Store this outside the server and deployment repository. Losing it makes
# encrypted backups unrecoverable.

BACKUP_RCLONE_REMOTE=
# Recommended in production. rclone destination for off-site backup copies,
# for example: s3:balican-production/database.

BACKUP_RETENTION_DAYS=14
# Optional. Number of days to retain local encrypted backups.

# === Rate Limits (defaults apply if not set) ===
# AUTH_RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
# AUTH_RATE_LIMIT_MAX=10               # 10 requests per window
# GLOBAL_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# GLOBAL_RATE_LIMIT_MAX=100           # 100 requests per window
