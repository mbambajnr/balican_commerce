# =============================================================================
# Bali-Can Limited — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================
#
# How to generate secrets:
#   JWT_SECRET:        openssl rand -hex 32
#   ADMIN_SECRET_KEY:  openssl rand -hex 16
#

# === Server ===
PORT=4000
# Optional. The port the backend server listens on. Defaults to 4000.

NODE_ENV=development
# Required. Set to 'production' for production deployments.
# In production, CORS origins, rate limits, and error verbosity are affected.

# === Database ===
DATABASE_URL=postgresql://sslplan:sslplan_dev@localhost:5432/sslplan
# Required. PostgreSQL connection string.
# Production: postgresql://user:password@host:port/dbname?sslmode=require

# === JWT ===
JWT_SECRET=your-jwt-secret-here
# Required. Used to sign and verify auth tokens.
# Production: Set a long, random value. Rotate if compromised.

JWT_EXPIRES_IN=7d
# Optional. Token expiry duration (e.g. 7d, 24h, 1h). Defaults to 7d.

# === Paystack ===
PAYSTACK_SECRET_KEY=
# Optional for development. Required for live payment processing.
# Production: Set both secret and public keys.
# Get from: https://dashboard.paystack.com/#/settings/developer

PAYSTACK_PUBLIC_KEY=
# Optional for development. Required for the frontend Paystack button.
# Get from: https://dashboard.paystack.com/#/settings/developer

# === Paystack Webhook ===
PAYSTACK_WEBHOOK_SECRET=
# Required in production. Without this (or PAYSTACK_SECRET_KEY), the webhook
# endpoint will reject ALL requests with HTTP 500.
# In production, NODE_ENV=production ensures the webhook fails closed.
# For development/testing, the webhook silently accepts when unset.
# Set to your Paystack secret key (starts with sk_ or sk_live_) or the
# webhook secret from Paystack Dashboard → Settings → Webhooks → Webhook Secret.
# HMAC SHA-512 verification is performed against the raw request body bytes.

# === Email (Resend) ===
RESEND_API_KEY=
# Optional. Resend API key for transactional emails.
# Leave empty to disable email sending (notifications still logged to email_logs table).
# Get from: https://resend.com/api-keys

RESEND_FROM_EMAIL=
# Optional. The "from" email address for transactional emails.
# Defaults to no-reply@yourdomain.com if not set.

# === Frontend ===
FRONTEND_URL=http://localhost:3000
# Required. The frontend URL used for CORS origin and redirects.
# Production: Set to your actual frontend domain (e.g. https://sslplan.com).
# Multiple origins: Not supported; set one canonical URL here.

# === Elasticsearch ===
ELASTICSEARCH_URL=http://localhost:9200
# Optional. Elasticsearch connection string for product search indexing.
# Leave empty to disable ES (product search falls back to SQL LIKE queries).
# Production: Set to your production ES endpoint.

# === Merchant Center Feed ===
FRONTEND_URL=https://sslplan.com
# Used by /api/products/merchant-feed to generate product links in the
# Google Merchant Center XML feed.
# Must be your production frontend URL.

# === Admin ===
ADMIN_SECRET_KEY=
# Required for admin account registration. Set a strong, secret value.
# Admin registration is DISABLED when this is empty.
# Register at: /admin/register (frontend) or POST /api/auth/admin-register (API)
# Do NOT commit this value to version control.

# === Upload (not yet used — reserved for future file uploads) ===
# UPLOAD_DIR=uploads
# MAX_FILE_SIZE=10485760

# === Rate Limits (defaults apply if not set) ===
# AUTH_RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
# AUTH_RATE_LIMIT_MAX=10               # 10 requests per window
# GLOBAL_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# GLOBAL_RATE_LIMIT_MAX=100           # 100 requests per window
