# =============================================================================
# Bali-Can Limited — Frontend Production Environment Variables
# =============================================================================
# This file documents the frontend env vars expected in production.
# These values are set via docker compose build args (../.env), NOT directly here.
# Keep this file as documentation only.
#
# How to generate secrets:
#   AUTH_SECRET:  openssl rand -base64 32
# =============================================================================

# === Next.js Auth (Auth.js / NextAuth v5) ===
# AUTH_SECRET=...                    # (set from .env → docker compose build arg)
# AUTH_URL=...                       # (set from .env → docker compose build arg)

# === Backend API ===
# NEXT_PUBLIC_API_URL=...            # (set from .env → docker compose build arg)

# === Paystack ===
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=   # (NOT READ from env; set directly in components)
