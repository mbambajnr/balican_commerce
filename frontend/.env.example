# =============================================================================
# Bali-Can Limited — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================
#
# How to generate secrets:
#   AUTH_SECRET:  openssl rand -base64 32
#

# === Next.js Auth (Auth.js / NextAuth v5) ===
AUTH_SECRET=your-auth-secret-here
# Required. Used by Auth.js for session encryption, CSRF tokens, and cookies.
# Production: Set a long, random value. Rotate if compromised.

AUTH_URL=http://localhost:3000
# Required. The canonical URL of the site. Used by Auth.js for redirects and callbacks.
# Production: Must be your actual domain (e.g. https://sslplan.com).
# Must exactly match the domain users will access.

# === Backend API ===
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Optional legacy public URL used only by integrations that explicitly reference it.
# Application API traffic uses the same-origin /backend-api proxy.

BACKEND_API_URL=http://localhost:4000/api
# Server-only backend URL used by Auth.js and the authenticated API proxy.
# Production Compose uses http://backend:4000/api. Do not expose this value to browser code.

# === Paystack ===
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Optional for development. Required for the frontend Paystack payment button.
# Production: Set to your live Paystack public key.
# Test mode: Use Paystack test public key (starts with pk_test_).
# Get from: https://dashboard.paystack.com/#/settings/developer

# === Ad Tracking (all optional — pixels fire only after cookie consent) ===
NEXT_PUBLIC_GTM_ID=
# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Leave empty to disable GTM.

NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable GA4.

NEXT_PUBLIC_META_PIXEL_ID=
# Meta (Facebook) Pixel ID (e.g. 1234567890).
# Leave empty to disable Meta Pixel.
